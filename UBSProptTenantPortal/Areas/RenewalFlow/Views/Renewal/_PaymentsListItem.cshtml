@model RecordOutStanding
@{
    var cardPaymentListLength = ViewBag.CardPaymentListLength as List<int>;
    var bankTransferListLength = ViewBag.BankTransferListLength as List<int>;
    var isPaymentValue = ViewBag.IsPaymentValue as int? ?? 0;
}


    <div class="payment-item">
        <div class="d-flex align-items-start">
            <input type="checkbox"
                   class="form-check-input me-2 payment-checkbox"
                   data-id="@Model.ContractPaymentId"
                   data-amount="@Model.Amount"
                   @(Model.IsChecked ? "checked=\"checked\"" : "")
                   onchange="toggleRecordCheck(this)"
                   @(Model.IsChecked == true ? "disabled" : "") />


            <div class="d-flex justify-content-between w-100">
                <span>@Model.Title</span>
                <span class="fw-semibold">AED @Model.Amount?.ToString("N2")</span>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-1" style="padding-left: 22px">
            <span>Due Date</span>
            <span class="text-primary">@Model.PaymentDate</span>
        </div>

        <hr />
    </div>
