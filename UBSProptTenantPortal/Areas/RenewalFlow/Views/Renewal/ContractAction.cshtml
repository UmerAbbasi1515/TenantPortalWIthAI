@model ContractRenwalViewModelDemo
@{
    ViewData["Title"] = "Contract Flow";
    var directionClass = LabelsLandlordPortal._language == "English" ? "ltr" : "rtl";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string activeTab = ViewBag.TabName;
}

<head>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="~/css/site.css">
    <script src="~/js/dashboard-main.js" asp-append-version="true"></script>

    <style>
        .tab-container {
            margin: 0 20px;
            background-color: white;
        }

        .nav-tabs .nav-link.active {
            background-color: white;
            font-weight: bold;
        }

        .circle {
            width: 25px;
            height: 25px;
            border-radius: 50%;
            background-color: #43B9B2;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-right: 5px;
        }

        .sticky-header {
            position: sticky;
            top: 0;
            background-color: white;
            border-bottom: 1px solid #ccc;
        }

        .table-container {
            margin: 20px;
        }

        .table thead {
            background-color: #f0f0f0;
        }
    </style>
</head>

<div class="text-center" style="height: 100vh;">

    @* ===== Tabs: Renewal / New contract flow ===== *@
    <ul class="nav nav-tabs border-tab nav-info tab-container sticky-tabs" id="serviceRequestTabs" role="tablist"
        style="margin: 0 2px 3px 2px; margin-top: 5px; padding-top: 12px;">
        <li class="nav-item" role="presentation">
            <a class="nav-link nav-border font-info tab-info @(activeTab == "RCF" ? "active" : "")"
               id="RCF-tab" data-bs-toggle="tab" href="#RCF" role="tab">
                <i class="fa-solid fa-screwdriver-wrench"></i> Renwal Contract Flow
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link nav-border font-info tab-info @(activeTab == "NCF" ? "active" : "")"
               id="NCF-tab" data-bs-toggle="tab" href="#NCF" role="tab">
                <i class="fa-solid fa-file-contract"></i> New Contract Flow
            </a>
        </li>
    </ul>

    @* ===== Results ===== *@
    <div style="display: flex; flex-direction: column; height: 100%; padding: 0;">
        @if (!string.IsNullOrEmpty(ViewBag.errorGetServiceReqPMFM as string))
        {
            <div class="card-header pb-0" style="flex-shrink: 0;">
                <center style="padding-top: 50px;">
                    <h4 style="padding-top: 5px;">@ViewBag.errorGetServiceReqPMFM</h4>
                </center>
                <i class="fa fa-refresh" aria-hidden="true"
                   style="padding-top: 5px; font-size: 18px; color: black;"
                   onclick="getContractsofDashboardCards()"></i>
            </div>
        }
        else
        {
            <div class="tab-content">

                <div class="tab-pane fade @(activeTab == "RCF" ? "show active" : "")"
                     id="RCF" role="tabpanel">
                    @Html.Partial("_ContractRenewalFlow", Model?.renwalContract?.Contracts)
                </div>

                <div class="tab-pane fade @(activeTab == "NCF" ? "show active" : "")"
                     id="NCF" role="tabpanel">
                    @Html.Partial("_ContractNewFlow", Model?.newContract?.Contracts)
                </div>

            </div>
        }
    </div>
</div>

@* ===== Full page loader ===== *@
<div id="fullPageLoader" style="
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
        z-index: 99999;
        display: none;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 20px;
        color: white;">
    <div>
        <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div style="margin-top: 15px;">Loading...</div>
    </div>
</div>

<!-- Scripts -->
<script>// Safely parse a fetch Response body as JSON.
    // Returns null if the body is empty or is not valid JSON, instead of throwing.
    async function readSafeJson(response) {
        try {
            const text = await response.text();
            return text ? JSON.parse(text) : null;
        } catch (e) {
            console.error('Invalid JSON response:', e);
            return null;
        }
    }

    function showLoader() {
        const loader = document.getElementById('fullPageLoader');
        if (loader) loader.style.display = 'flex';
    }

    function hideLoader() {
        const loader = document.getElementById('fullPageLoader');
        if (loader) loader.style.display = 'none';
    }

    
    });</script>