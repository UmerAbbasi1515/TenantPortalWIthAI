@model PaymentResponse
@{
    ViewData["Title"] = "Payments ";
    var directionClass = LabelsLandlordPortal._language == "English" ? "ltr" : "rtl";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="~/css/site.css"> <!-- Link to your CSS file -->
    <style>
        .sticky-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background-color: white;
            border-bottom: 1px solid #ccc;
        }

        .table-container {
            margin: 20px;
        }

        .table thead {
            background-color: #f0f0f0;
        }
    </style>
</head>
<div class="text-center" style="height: 100vh;">
    <div class="card pageheader">
        <div class="card-header">
            <div class="row">
                <div class="col-12 text-start">
                    <h4>
                        <i class="fa-solid fa-file-invoice-dollar"></i> Payments
                    </h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12 col-lg-12 col-xl-12 d-flex">
        <div class="card invoice-card mb-0 w-100" style="display: flex; flex-direction: column; height: 100%;">
            @if (ViewBag.errorGetPayments != "")
            {
                <div class="card-header pb-0" style="height: 350px">
                        <center style="padding-top: 150px;">

                            @if (@ViewBag.errorGetPayments == "")
                            {
                                <h4>No Data Found</h4>
                            }
                            else
                            {
                                <h4>@ViewBag.errorGetPayments</h4>
                            }

                        </center>
                        <i class="fa fa-refresh" aria-hidden="true" style="padding-top: 5px; font-size: 18px; color: black;"
                           onclick="window.location.href = '@Url.Action("Payments", "Payment" , new { area = "Payments" })'"></i>
                    </div>
                }
            else
                {

                    <div class="card-body d-flex flex-column" style="flex-grow: 1;">
                        <div class="table-responsive">
                            <table class="table mb-0 datatable-table" id="contract-table" tabindex="2" style="table-layout: fixed; margin-top: 0px !important; margin-right: 0px !important;">
                                <thead>
                                    <tr>
                                        <th style="width: 70px">S No</th>
                                        <th style="text-align: left; padding-left: 10px;">Receipt No</th>
                                        <th style="text-align: center;">Contract No</th>
                                        <th style="text-align: center;">Payment Type</th>
                                        <th style="text-align: center;">Receipt Date</th>
                                        <th style="text-align: center;">Payment For</th>
                                        <th style="text-align: center;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < @Model?.Payments?.Count; i++)
                                    {
                                        var payment = Model.Payments[i];
                                        var values = $"{payment?.Amount} | {payment?.PaymentFor} | {payment?.PaymentDate} | {payment?.PaymentType} | {payment?.TransactionId} | {payment?.ReceiptNo}";

                                        int index = @i + 1;
                                        <tr>
                                            <td style="text-align: left; padding-left: 15px;">
                                                @index
                                            </td>
                                            <td style="text-align: left; padding-left: 10px;">
                                                <a href="@Url.Action("PaymentDetail", "Payment", new { area = "Payments",  values = values })">
                                                    <h6 class="f-w-500" style="color: #198754; padding-left: 10px;">@payment?.ReceiptNo</h6>
                                                </a>
                                            </td>
                                            <td style="text-align: center;">@payment?.ContractNo</td>
                                            <td style="text-align: center;">@payment?.PaymentType</td>
                                            <td style="text-align: center;">@payment?.PaymentDate</td>
                                            <td style="text-align: center;">@payment?.PaymentFor </td>
                                            <td style="text-align: center;">AED @payment?.Amount?.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
    </div>
</div>