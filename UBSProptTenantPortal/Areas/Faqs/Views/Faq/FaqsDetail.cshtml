@model FaqsDetailViewModelResponse

@{
    ViewData["Title"] = "FAQs Detail";
    Layout = "~/Views/Shared/_Profilelayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="~/css/site.css"> <!-- Link to your CSS file -->
</head>
<div class="card pageheader" style="margin-bottom: 0px !important;">
    <div class="card-header">
        <div class="row">
            <div class="col-sm-6">
                <a class="sidebar-link" href="@Url.Action("Faqs", "Faq", new { area = "Faqs" })">
                    <h4><i class="fa fa-arrow-left"></i> FAQs Detail</h4>
                </a>
            </div>
        </div>
    </div>
</div>
<div class="card">
    @if (!string.IsNullOrEmpty(ViewBag.errorGetFaqsDetail))
        {
        <div class="card-header pb-0" style="height: 350px;text-align: center;">
            <center style="padding-top: 150px;">

                <h4>@ViewBag.errorGetFaqsDetail</h4>

            </center>
            <i class="fa fa-refresh" aria-hidden="true" style="padding-top: 5px; font-size: 18px; color: black;"
               onclick="window.location.href = '@Url.Action("Faqs", "Faq", new { area = "Faqs" })'"></i>
        </div>
        }
        else
        {
        <div class="listScroll h-100">
            <ul class="list-group ui-sortable faq-list">
                @for (int i = 0; i < (Model.Data?.Count ?? 0); i++)
                    {
                    <li class="list-group-item odd faq-item" style="border-color: #6a71854d !important; margin: 7px;">
                        <div class="faq-header" style="justify-content: space-between; display: flex; align-items: center; cursor: pointer;">
                            <div style="text-align: left;">
                                @Model.Data?[i].Title
                            </div>
                            <div class="faq-toggle" style="display: flex; align-items: center;">
                                <i class="material-icons" style="margin-left: 70px;">keyboard_arrow_down</i>
                            </div>
                        </div>
                        <div class="faq-description" style="display: none; margin-top: 10px;">
                            <div style="text-align: left; font-weight: 100;">
                                @Model.Data?[i].Description
                            </div>
                        </div>
                    </li>
                    }
            </ul>
        </div>
        }
    </div>

<script src="~/js/profile-page-scripts.js"></script>
