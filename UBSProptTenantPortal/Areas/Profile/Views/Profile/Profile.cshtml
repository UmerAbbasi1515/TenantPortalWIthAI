@model ProfileViewModelResponse
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Profilelayout.cshtml";
}


<div class="card pageheader mb-0">
    <div class="card-header">
        <div class="row">
            <div class="col-sm-6">
                <h4><i class="fa fa-user"></i> Profile</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(ViewBag.erroProfile as string))
        {
            <div class="card-header pb-0" style="height: 375px;">
                <center style="padding-top: 130px;">
                    <center style="padding-top: 50px;">
                        @if (@ViewBag.erroProfile == "")
                        {
                            <h4>No Data Found</h4>
                        }
                        else
                        {<h4>@ViewBag.erroProfile</h4>}

                    </center>
                    <div style="height: 10px;"></div>
                    <a href="@Url.Action("Profile", "Profile", new {area = "Profile"})">
                        <i class="fa fa-refresh" aria-hidden="true" style="padding-top: 5px; font-size: 18px; color: black;">
                        </i>
                    </a>
                </center>
            </div>
        }
        else
        {
            <div class="row alert alert-light-primary  subtitle" role="alert">
                <div class="col-sm-6">
                    <h5 style=" text-align: left; padding-left: 20px;">Personal Detail <span>(Tenant)</span></h5>
                </div>
            </div>

            <div class="ms-3 me-3 mt-3 text-start">
                <div class="col-sm-8 mb-3">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i>
                        <span> Mobile</span>
                    </div>
                    <input type="text" class="form-control" placeholder="enter mobile number" id="Mobile" name="Mobile"
                           value="@Model?.Data?[0].Mobile" readonly />
                </div>

                <div class="col-sm-8 mb-3">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                        <span> Name</span>
                    </div>
                    <input type="text" class="form-control" placeholder="enter first name" id="FirstName" name="FirstName"
                           value="@Model?.Data?[0].name" readonly />
                </div>

                <div class="col-sm-8 mb-3">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                        <span> Email</span>
                    </div>
                    <input type="text" class="form-control" placeholder="enter email" id="Email" name="Email"
                           value="@Model?.Data?[0].Email" readonly />
                </div>

                <div class="col-sm-8 mb-3">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                        <span> Address</span>
                    </div>
                    <textarea class="form-control" id="Address" name="Address" readonly>@Model?.Data?[0].Address</textarea>
                </div>

                @if ((string)ViewBag.canEditProfile == "you can add new case")
                {
                    <div class="text-end mt-3 col-sm-8 pb-2">
                        <a class="btn btn-primary w-100 text-white" href="#" onclick="">Update Profile</a>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
<script src="~/js/profile-page-scripts.js"></script>
}
