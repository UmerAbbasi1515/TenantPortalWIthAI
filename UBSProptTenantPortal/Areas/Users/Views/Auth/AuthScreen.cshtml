                const dropDown = document.getElementById("languageID");
                const selectedLanguage = dropDown.options[dropDown.selectedIndex].value;
                document.cookie = "selectedLanguage=" + encodeURIComponent(selectedLanguage) + "; path=/";

                const mainLeft = document.getElementById("mainLeft");
                if (selectedLanguage === "English") {
                    mainLeft.classList.remove('arabiclanguage');
                    mainLeft.classList.add('englishlanguage');
                    dropDown.classList.remove('rtl');
                    dropDown.classList.add('ltr');
                } else {
                    mainLeft.classList.remove('englishlanguage');
                    mainLeft.classList.add('arabiclanguage');
                    dropDown.classList.remove('ltr');
                    dropDown.classList.add('rtl');
                }

                // Refresh the page to apply the new language
                location.reload();
