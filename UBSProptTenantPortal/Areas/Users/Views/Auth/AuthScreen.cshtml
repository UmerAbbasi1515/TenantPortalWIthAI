                }
            }

            function signInWithPhone(phoneNumber, isForgotMpin) {
                showLoader();
                btnshowLoader("btngetOTPID");

                // Safety timer: if the user dismisses reCAPTCHA and Firebase hangs
                const safetyTimer = setTimeout(() => {
                    btnhideLoader("btngetOTPID");
                    hideLoader();
                    resetForgotMpinState(isForgotMpin);
                    showErrorMessage(document.getElementById("divPhoneNumber"), "reCAPTCHA timed out. Please try again.");
                }, 10000);

                signInWithPhoneNumber(auth, phoneNumber, appVerifier)
                    .then((confirmationResult) => {
                        clearTimeout(safetyTimer);
                        btnhideLoader("btngetOTPID");
                        hideLoader();
                        resetForgotMpinState(isForgotMpin);

                        document.querySelectorAll("#pin-container .pin-input").forEach(input => {
                            input.value = "";
                        });

                        document.cookie = "maskedPhoneNumber=" + encodeURIComponent(maskPhoneNumber(phoneNumber)) + "; path=/";
                        window.confirmationResult = confirmationResult;

                        if (isForgotMpin == "True") {
                            document.getElementById('isForgotMpin').value = isForgotMpin;
                            document.getElementById("divmpin").style.display = 'none';
                        }

                        clearPins("#divOTPValidation .pin-input");
                        document.getElementById("divPhoneNumberValidation").style.display = 'none';
                        clearErrorMessages(otpByPhone);
                        document.getElementById('VerifyOtpButtonByPhone').innerText = "@AuthLabelsPortal.verify";
                        document.getElementById("divOTPValidation").style.display = 'block';
                    })
                    .catch((error) => {
                        clearTimeout(safetyTimer);
                        btnhideLoader("btngetOTPID");
                        hideLoader();
                        resetForgotMpinState(isForgotMpin);
                        handleFirebaseError(error);
                    });
            }

            function handleFirebaseError(error) {
                btnhideLoader("btngetOTPID");
                hideLoader();

                let errorMessage = 'Error: ' + error.message;
                switch (error.code) {
                    case 'auth/invalid-phone-number':
                        errorMessage = 'The Mobile Number is not valid. Please enter a valid Mobile Number';
                        break;
                    case 'auth/missing-verify-code':
                        errorMessage = 'Verification code is missing.';
                        break;
                    case 'auth/quota-exceeded':
                        errorMessage = 'SMS quota exceeded. Please try again later.';
                        break;
                    case 'auth/too-many-requests':
                        errorMessage = 'Too many requests. Please try again later.';
                        break;
                    case 'auth/network-request-failed':
                        errorMessage = 'Network request failed. Please check your internet connection.';
                        break;
                }
                console.error(errorMessage, error);

                showErrorMessage(document.getElementById("divPhoneNumber"), '@AuthLabelsPortal.pleaseEnterValidEPhone');
            }

            // Get OTP / Forgot MPIN button handler
            window.getPhoneNumberValidation = function (isForgotMpin) {
                btnshowLoader("btngetOTPID");
                if (isForgotMpin == "True") {
                    clearErrorMessages(divmpinOTP);
                    btnshowLoader("btnforgotMpin");
                    document.getElementById('VerifyOtpButtonByPhone').innerText = "@AuthLabelsPortal.verify";
                }

                const countryCode = document.getElementById("country").value;
                const phoneInput = document.getElementById("phone").value;
                clearErrorMessages(divCountryCode);
                clearErrorMessages(divPhoneNumber);

                if (!countryCode || !phoneInput) {
                    if (!countryCode) {
                        btnhideLoader("btngetOTPID");
                        resetForgotMpinState(isForgotMpin);
                        showErrorMessage(divCountryCode, '@AuthLabelsPortal.pleaseSelectCountryCode');
                    }
                    if (!phoneInput) {
                        btnhideLoader("btngetOTPID");
                        resetForgotMpinState(isForgotMpin);
                        showErrorMessage(divPhoneNumber, '@AuthLabelsPortal.pleaseEnterPhoneNoFirst');
                    }
                    return;
                }

                btnhideLoader("btngetOTPID");
                resetForgotMpinState(isForgotMpin);

                signInWithPhone(countryCode + phoneInput, isForgotMpin);
            };
        </script>

