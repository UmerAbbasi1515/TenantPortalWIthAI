                                </center>
                            </div>
                        </div>


                        @* USER ROLES *@
                        <div class="login-main login-dark login-bg" id="divSelectRole"
                             style="display: none; padding: 20px;">
                            <div>
                                <form class="theme-form" style="padding-top:65px">
                                    <h4 class="text-center" id="userNameField">@AuthLabelsPortal.userNameEng</h4>
                                    <p class="text-center">@AuthLabelsPortal.selectRole</p>
                                    <div id="divSelectRoleErr">
                                        <div class="listScroll" id="roleContainer"></div>
                                    </div>
                                    <div class="form-group mb-0 checkbox-checked">
                                        <div class="text-end mt-4 pb-5">
                                            <a class="btn btn-primary btn-block w-100 text-white" href="#"
                                               id="resetUserRoleButton" style="display: bloc;"
                                               onclick="restGetUserRole()">@AuthLabelsPortal.reset</a>
                                        </div>
                                    </div>
                                </form>

                            </div>
                        </div>

                        @* MPIN *@
                        <div class="login-main login-dark login-bg" id="divmpin" style="display: none;padding: 20px;">
                            <div>

                                <form class="theme-form">
                                    <p id="roleID" style="display:none"></p>
                                    <h2 class="text-center">@AuthLabelsPortal.mpinVerification</h2>
                                    <p class="text-center">@AuthLabelsPortal.enterYourmPin</p>
                                    <div id="divmpinOTP" style="text-align: center;">
                                        <div class="pin-container" style="display: flex">
                                            <input type="text" inputmode="numeric" maxlength="1" class="mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="mpin-input" oninput="moveToNext(this)">
                                        </div>
                                    </div>
                                    <div class="form-group mb-0 checkbox-checked">
                                        <p style="text-align: center; padding-top: 5px;">
                                            @AuthLabelsPortal.personalDataDisclaimerShare
                                        </p>
                                        <div class="text-end mt-4 pb-5">
                                            <a class="btn btn-primary btn-block w-100 text-white" href="#"
                                               id="VerifymPinBtnButton" style="display: bloc;"
                                               onclick="ValidateRoleByMPIN()">@AuthLabelsPortal.login</a>
                                        </div>

                                    </div>
                                    <center>
                                        <a href="#" onclick="getPhoneNumberValidation('True')"
                                           style="text-decoration: underline; color: #43B9B2" id="btnforgotMpin">@AuthLabelsPortal.forgotMpin</a>

                                    </center>
                                    <center>
                                        <a href="#" onclick="cancelMpin()"
                                           style="text-decoration: underline;">@AuthLabelsPortal.cancel</a>
                                    </center>
                                </form>

                            </div>
                        </div>


                        @* Reset MPIN *@

                        @*New For MPIN*@
                        <input id="isForgotMpin" type="hidden" />
                        @*END*@

                        <div class="login-main login-dark login-bg" id="divSetNewMpin" style="display: none;padding: 20px;">
                            <div>
                                <div id="" style="display:block; text-align:center;">

                                    <!-- Enter New MPIN -->
                                    <h2 class="text-center" style="margin-bottom: 1px !important;">Set your MPIN</h2>
                                    <p class="text-center" style=" margin-bottom: 1px !important;">Enter a six digit MPIN</p>
                                    <div id="divResetmpinOTP" style="text-align: center;">
                                        <div class="pin-container" style="display:flex; justify-content:center;">
                                            <input type="text" inputmode="numeric" maxlength="1" class="new-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="new-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="new-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="new-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="new-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="new-mpin-input" oninput="moveToNext(this)">
                                        </div>

                                        <br />

                                        <!-- Re-Enter MPIN -->
                                        <p class="text-center" style=" margin-bottom: 1px !important;">Re-Enter a six digit MPIN</p>
                                        <div class="pin-container" style="display:flex; direction:ltr; justify-content:center;">
                                            <input type="text" inputmode="numeric" maxlength="1" class="confirm-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="confirm-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="confirm-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="confirm-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="confirm-mpin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="confirm-mpin-input" oninput="moveToNext(this)">
                                        </div>
                                    </div>

                                    <center>
                                        <div class="text-end mt-4 pb-2">
                                            <a class="btn btn-primary btn-block w-100 text-white" href="#"
                                               id="resetMpinButton" style="display: block;"
                                               onclick="SaveNewMpin()">Save MPIN</a>
                                        </div>
                                    </center>

                                    <center>
                                        <a href="#" onclick="cancelResetMpin()"
                                           style="text-decoration: underline;">@AuthLabelsPortal.cancel</a>
                                    </center>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Grid system xl col 5 and padding 0 end BASICALLY right DIV -->
            </div>
            <!-- row class end -->
        </div>
        <div id="fullPageLoader" style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0,0,0,0.5);
                    z-index: 99999;
                    display: none;
                    justify-content: center;
                    align-items: center;
                    text-align: center;
                    font-size: 20px;
                    color: white;
                ">
            <div>
                <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div style="margin-top: 15px;">Loading...</div>
            </div>
        </div>

        @* =====================================================================
            MAIN SCRIPT (phone OTP, roles, MPIN, email flow, UI helpers)
            ===================================================================== *@
        <script>
            // =====================================================================
            // Safe JSON helper
            // Reads the response body once and never throws on empty / non-JSON bodies.
            // =====================================================================
            async function readJson(response, fallback = {}) {
                try {
                    const text = await response.text();
                    return text ? JSON.parse(text) : fallback;
                } catch (error) {
                    console.error('Invalid JSON response:', error);
                    return fallback;
                }
            }

            // Kept so every existing safeJson(...) call keeps working unchanged
            function safeJson(response, fallback = {}) {
                return readJson(response, fallback);
            }

            // =====================================================================
            // Phone / OTP flow
            // =====================================================================
            function getPhoneNumber() {
                const countryCode = document.getElementById("country").value;
                const phoneInput = document.getElementById("phone").value;
                return countryCode + phoneInput;
            }

            function verifyOTPValidation() {
                showLoader();
                btnshowLoader("VerifyOtpButtonByPhone");

                clearErrorMessages(otpByPhone);

                let pin = '';
                document.querySelectorAll('.pin-input').forEach(input => pin += input.value);

                if (!pin) {
                    btnhideLoader("VerifyOtpButtonByPhone");
                    showErrorMessage(otpByPhone, "   Please enter the OTP sent to your Mobile Number");
                    hideLoader();
                    return;
                }
                if (pin.length !== 6) {
                    btnhideLoader("VerifyOtpButtonByPhone");
                    showErrorMessage(otpByPhone, "   Please enter the valid OTP sent to your Mobile Number");
                    hideLoader();
                    return;
                }

                const confirmationResult = window.confirmationResult;

                if (!confirmationResult) {
                    btnhideLoader("VerifyOtpButtonByPhone");
                    showErrorMessage(otpByPhone, "   Confirmation result is not defined. Please request a new OTP.");
                    hideLoader();
                    return;
                }

                confirmationResult.confirm(pin)
                    .then(async () => {
                        btnhideLoader("VerifyOtpButtonByPhone");
                        hideLoader();
                        await ValidateUserAndGeneratToken(pin);
                    })
                    .catch((error) => {
                        btnhideLoader("VerifyOtpButtonByPhone");
                        showErrorMessage(otpByPhone, "   Invalid OTP. Please try again with the correct OTP.");
                        console.error(error);
                        hideLoader();
                    });
            }

            // Call backend API to validate user and generate token
            async function ValidateUserAndGeneratToken(pin) {
                showLoader();
                btnshowLoader("VerifyOtpButtonByPhone");
                try {
                    const phoneNumber = getPhoneNumber();
                    document.cookie = "phoneNumber=" + encodeURIComponent(phoneNumber) + "; path=/";

                    const response = await fetch('/Users/Auth/GenerateFirbaseUserToken', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            Mobile: phoneNumber,
                            OTP: pin,
                            otpCode: pin,
                            OTPStatus: true
                        })
                    });

                    if (response.ok) {
                        btnhideLoader("VerifyOtpButtonByPhone");
                        const jsonResponse = await safeJson(response);
                        const token = jsonResponse.token;
                        const mpinSet = jsonResponse.mpinSet;
                        const isForgotMpin = document.getElementById('isForgotMpin').value;

                        if (mpinSet == "False") {
                            document.getElementById("divSetNewMpin").style.display = "block";
                            document.getElementById("divOTPValidation").style.display = 'none';
                            return;
                        } else if (isForgotMpin == 'True') {
                            clearPins("#divSetNewMpin .confirm-mpin-input");
                            clearPins("#divSetNewMpin .new-mpin-input");
                            document.getElementById("divSetNewMpin").style.display = "block";
                            document.getElementById("divOTPValidation").style.display = 'none';
                            return;
                        } else {
                            GetUserRole(token);
                        }
                    } else {
                        btnhideLoader("VerifyOtpButtonByPhone");
                        console.error('Error in response:', response.status);
                        showErrorMessage(otpByPhone, "   An error occurred while generating token. Please try again.");
                    }
                } catch (error) {
                    btnhideLoader("VerifyOtpButtonByPhone");
                    showErrorMessage(otpByPhone, "   Something went wrong. Please try again.");
                } finally {
                    hideLoader();
                }
            }

            // Refresh token (called on page load)
            async function refreshToken() {
                try {
                    const phoneNumber = getPhoneNumber();
                    if (!phoneNumber) { hideLoader(); return; }

                    const response = await fetch('/Users/Auth/RefreshToken', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Mobile: phoneNumber })
                    });

                    if (response.ok) {
                        const jsonResponse = await safeJson(response);
                        const token = jsonResponse.token;
                        await GetUserRole(token);
                        hideLoader();
                    } else {
                        hideLoader();
                        toastr.error('Error', "Something went wrong");
                        console.error('Error in response:', response.status);
                        showErrorMessage(otpByPhone, "   An error occurred while generating new token. Please try again.");
                    }
                } catch (error) {
                    hideLoader();
                    console.error('Error:', error);
                    showErrorMessage(otpByPhone, "   Something went wrong. Please try again.");
                }
            }

            // =====================================================================
            // Roles
            // =====================================================================
            async function GetUserRole(token) {
                showLoader();
                btnshowLoader("VerifyOtpButtonByPhone");
                btnshowLoader("resetMpinButton");
                try {
                    const response = await fetch('/Users/Auth/GetUserRoles', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({})
                    });

                    if (response.ok) {
                        btnhideLoader("VerifyOtpButtonByPhone");
                        btnhideLoader("resetMpinButton");
                        const jsonResponse = await safeJson(response);

                        document.getElementById('divSetNewMpin').style.display = 'none';
                        document.getElementById("divPhoneNumberValidation").style.display = 'none';
                        document.getElementById("divOTPValidation").style.display = 'none';
                        document.getElementById("divSelectRole").style.display = 'block';

                        const container = document.getElementById('roleContainer');
                        container.innerHTML = '';

                        if (jsonResponse.data && jsonResponse.data.length > 0) {
                            document.getElementById('userNameField').textContent = jsonResponse.userName;
                            jsonResponse.data.forEach(roleP => {
                                container.innerHTML += `
                                    <div style="display: flex; justify-content: space-between; align-items: center;
                                                padding: 10px; border: 1px solid #ddd; border-radius: 6px; margin: 5px 0;
                                                cursor: pointer; transition: background-color 0.2s ease;"
                                         onClick="ProceedToLogin(${roleP.roleId})"
                                         onmouseover="this.style.backgroundColor='#f9f9f9'"
                                         onmouseout="this.style.backgroundColor='white'">
                                        <div style="display: flex; align-items: center; padding-right: 10px;">
                                            <i class="fa fa-home" style="padding-left: 5px;"></i>
                                            <div style="text-align: left; padding-left: 25px;">
                                                ${roleP.roleName}
                                            </div>
                                        </div>
                                        <div>
                                            <i class="material-icons" style="margin-left: 8px;">keyboard_arrow_right</i>
                                        </div>
                                    </div>`;
                            });
                        } else {
                            container.innerHTML = "<center><p><b>No roles found.</b></p></center>";
                        }
                    } else {
                        btnhideLoader("VerifyOtpButtonByPhone");
                        btnhideLoader("resetMpinButton");
                        console.error('Error in response:', response.status);
                        showErrorMessage(otpByPhone, "   An error occurred while getting user roles. Please try again.");
                    }
                } catch (error) {
                    btnhideLoader("VerifyOtpButtonByPhone");
                    btnhideLoader("resetMpinButton");
                    showErrorMessage(otpByPhone, "   Something went wrong. Please try again.");
                } finally {
                    hideLoader();
                }
            }

            // Submit selected role ID and navigate to MPIN entry
            async function ProceedToLogin(id) {
                showLoader();
                try {
                    const response = await fetch('/Users/Auth/ProceedToLogin', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ UserRole: id.toString() })
                    });
                    clearErrorMessages(divSelectRoleErr);

                    if (response.ok) {
                        if (id.toString() == "4") {
                            await ValidatePublicRole(id.toString());
