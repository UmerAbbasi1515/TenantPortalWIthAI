            function showLoader() {
                const loader = document.getElementById('fullPageLoader');
                if (loader) loader.style.display = 'flex';
            }

            function hideLoader() {
                const loader = document.getElementById('fullPageLoader');
                if (loader) loader.style.display = 'none';
            }

            // =====================================================================
            // PIN inputs (OTP, MPIN, new MPIN, confirm MPIN)
            // =====================================================================
            function moveToNext(current) {
                if (current.value.length === 1) {
                    const next = current.nextElementSibling;
                    if (next) next.focus();
                }
                if (current.value.length === 0) {
                    const prev = current.previousElementSibling;
                    if (prev) prev.focus();
                }
            }

            function bindPinInputs(selector) {
                const inputs = document.querySelectorAll(selector);

                inputs.forEach((input, index) => {
                    input.addEventListener("input", function () {
                        // Keep only numbers
                        this.value = this.value.replace(/[^0-9]/g, '');

                        // Move to next input if a number is entered
                        if (this.value.length === 1 && index < inputs.length - 1) {
                            inputs[index + 1].focus();
                        } else {
                            // Non-numeric input keeps focus here
                            this.focus();
                        }
                    });

                    input.addEventListener("keydown", function (e) {
                        // Backspace on an empty box goes to the previous one
                        if (e.key === "Backspace" && this.value === "" && index > 0) {
                            inputs[index - 1].focus();
                        }
                    });
                });
            }

            ['.pin-input', '.mpin-input', '.new-mpin-input', '.confirm-mpin-input'].forEach(bindPinInputs);
