                        </div>

                        @* OTP DIV *@
                        <div class="login-main login-dark login-bg" id="divOTPValidation" style="display: none; padding: 20px;">
                            <div>
                                <form class="theme-form" style="padding-top:60px">
                                    <h2 class="text-center">@AuthLabelsPortal.otpVerification</h2>
                                    <div style="padding-top:5px"></div>
                                    <p class="text-center">
                                        @AuthLabelsPortal.enterTheCode<span id="phoneNumberDisplay"></span>
                                    </p>
                                    <div id="otpByPhone" style="text-align: center;">
                                        <div class="pin-container" style="display: flex;">
                                            <input type="text" inputmode="numeric" maxlength="1" class="pin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="pin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="pin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="pin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="pin-input" oninput="moveToNext(this)">
                                            <input type="text" inputmode="numeric" maxlength="1" class="pin-input" oninput="moveToNext(this)">
                                        </div>
                                    </div>
                                    <div class="form-group mb-2 checkbox-checked">
                                        <div class="text-end mt-4 pb-5">
                                            <a class="btn btn-primary btn-block w-100 text-white" href="#"
                                               id="VerifyOtpButtonByPhone" style="display: block;margin-top: 4px;"
                                               onclick="verifyOTPValidation()">@AuthLabelsPortal.verify</a>
