@using UBSProptTenantPortal
@model SrReqDetailMainDocumentCommunication
@{
    string tabname = ViewBag.TabName;
    string callingFrom = ViewBag.CallingFrom;
    var ServiceRequestNo = ViewData["ServiceReqNoTitle"];

    ViewData["Title"] = $"Request No. {ServiceRequestNo}";
    ViewBag.ServiceRequestNo = ServiceRequestNo;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var detail = Model?.mainInfo?.Detail;
    string statusClass = LabelsTenantPortal.GetStatusCssClass(detail?.Status ?? "");

    // Back link: renewal flow when opened from Renewal / New, otherwise the service request list
    var backUrl = (callingFrom == "Renewal" || callingFrom == "New")
        ? Url.Action("ContractAction", "Renewal", new { area = "RenewalFlow", tab = callingFrom == "Renewal" ? "RCF" : "NCF" })
        : Url.Action("ServiceRequests", "ServiceRequest", new { area = "ServiceRequests", tab = tabname });

    // FM requests have no Documents tab
    var showDocumentsTab = tabname != "FM";
}

@* =====================================================================
    STYLES / VENDOR RESOURCES
    ===================================================================== *@
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link rel="stylesheet" href="~/css/site.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<link rel="stylesheet" href="../assets/css/style.css">

<style>
    /* ---------- Tabs ---------- */
    .tab-container {
        margin: 20px;
    }

    .tabs {
        list-style-type: none;
        padding: 0;
        display: flex;
    }

    .tab {
        padding: 10px 20px;
        cursor: pointer;
        background-color: lightgray;
        border: 1px solid #ccc;
        border-bottom: none;
        margin-right: 5px;
    }

    .tab-content {
        display: none;
    }

        /* This is basically for show */
        .tab-content.active {
            display: block;
        }

    .sticky-header {
        position: sticky;
        top: 0;
        background-color: white;
    }

    /* ---------- Property / detail layout ---------- */
    .property-details {
        display: flex;
        flex-direction: column;
        width: 100%;
        padding-left: 10px;
        padding-right: 10px;
    }

    .property-details-row {
        display: flex;
        flex-direction: row;
        width: 100%;
        margin-bottom: 10px;
    }

    .detail {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .detail p {
            margin: 0;
        }

    .list-group-item {
        transition: background-color 0.3s ease; /* Smooth transition for background color */
    }

        .list-group-item:hover {
            background-color: #bfd1ec;
        }

    .circle {
        width: 25px;
        height: 25px;
        border-radius: 50%;
        background-color: #43B9B2;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 5px;
    }

    .circle-charges {
        width: 25px;
        height: 25px;
        border-radius: 50%;
        background-color: #98f4ee;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 5px;
    }

    .card {
        transition: all 0.2s ease-in-out;
    }

        .card:hover {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

    .p-style {
        padding-left: 23px;
    }

    /* ---------- Modals ---------- */
    .modal-content {
        background-color: #ffffff;
        width: 90%;
        max-width: 800px;
        border-radius: 12px;
        position: relative;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
    }

    .close-custom {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 24px;
        font-weight: bold;
        color: #aaa;
        cursor: pointer;
    }

        .close-custom:hover {
            color: #000;
        }

    .cancel-modal {
        display: none;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .cancel-modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        padding: 30px;
        border: 1px solid #888;
        border-radius: 8px;
        width: 90%;
        max-width: 400px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        position: relative;
    }

        .cancel-modal-content button {
            margin: 5px;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

            .cancel-modal-content button:first-of-type {
                background-color: #43B9B2;
                color: white;
            }

            .cancel-modal-content button:hover {
                opacity: 0.8;
            }

    .close-modal {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        line-height: 20px;
        cursor: pointer;
    }

        .close-modal:hover,
        .close-modal:focus {
            color: #000;
        }

    /* ---------- Documents ---------- */
    .upload-small {
        height: 60px !important;
        transition: height 0.3s ease;
    }

    .uploadDoc {
        background-color: #42ae950f !important;
        border: 2px dashed #bbd9d7a6 !important;
        border-radius: 12px;
    }

        .uploadDoc:hover {
            background-color: #42ae950f !important;
            border: 2px dashed #43B9B2 !important;
            border-radius: 12px;
        }

    .uploadDocN {
        border-radius: 10px;
        overflow: hidden;
        background: #f8f9fa;
        text-align: center;
        height: 320px; /* Fixed card height */
        cursor: pointer;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* Preview area */
    .preview-box {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 180px; /* makes sure preview has height */
        background: #e9eef3;
        position: relative;
    }

    .doc-img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
    }

    .doc-icon {
        font-size: 4rem;
        color: gray;
    }

    /* Hover overlay */
    .overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, .35);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }

    .preview-box:hover .overlay {
        opacity: 1;
    }

    .doc-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
    }

    /* Footer fixed at bottom */
    .doc-footer {
        display: flex;
        justify-content: space-between;
        padding: 6px 10px;
        background: #fff;
        font-size: 14px;
        border-top: 1px solid #eee;
    }

    .photo-container {
        display: inline-block;
        transition: transform 0.2s;
    }

        .photo-container:hover {
            transform: scale(1.05);
        }

    .delete-btn {
        background-color: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        padding: 2px;
        transition: background-color 0.2s;
    }

        .delete-btn:hover {
            background-color: rgba(255, 255, 255, 1);
        }

    .delete-icon {
        position: absolute;
        top: 5px;
        right: 5px;
        background: transparent;
        border: none;
        color: #e74c3c; /* red */
        font-size: 18px;
        cursor: pointer;
    }

        .delete-icon:hover {
            color: #c0392b; /* darker red */
        }

    /* ---------- Buttons / colors ---------- */
    .bg-teal {
        background-color: #43B9B2;
    }

    .btn-download {
        background-color: #ffffff;
        color: #000000;
        border: 1px solid #ccc;
    }

        .btn-download:hover {
            background-color: #eee5e5;
            color: #000000;
            border-color: #999;
        }

    .btn-teal {
        background: #009688;
        color: #fff;
    }

        .btn-teal:hover {
            background: #00796B;
            color: #fff;
        }

    /* ---------- Forms ---------- */
    /* Make the label required with red * */
    label.required::after {
        content: " *";
        color: red;
    }

    /* Stack label + input vertically */
    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 1rem;
    }
</style>

@* =====================================================================
    SHARED HELPERS (loaders + safe JSON reader)
    ===================================================================== *@
<script>// Reads a fetch Response body once and never throws on empty / non-JSON bodies.
    async function readJsonSafely(response, fallback = {}) {
        try {
            const text = await response.text();
            return text ? JSON.parse(text) : fallback;
        } catch (error) {
            console.error('Invalid JSON response:', error);
            return fallback;
        }
    }

    function showLoader() {
        const loader = document.getElementById('fullPageLoader');
        if (loader) loader.style.display = 'flex';
    }

    function hideLoader() {
        const loader = document.getElementById('fullPageLoader');
        if (loader) loader.style.display = 'none';
    }

    function showLoaderEID() {
        const loader = document.getElementById('fullPageLoaderEID');
        if (loader) loader.style.display = 'flex';
    }

    function hideLoaderEID() {
        const loader = document.getElementById('fullPageLoaderEID');
        if (loader) loader.style.display = 'none';
    }</script>

@* =====================================================================
    PAGE
    ===================================================================== *@
<div class="text-center" style="height: 100vh;">

    @* ---------- Page header ---------- *@
    <div class="card pageheader" style="box-shadow: none;">
        <div class="card-header">
            <div class="row">
                <div class="col-12 text-start" style="display:flex; flex-direction:row; justify-content:space-between">
                    <a class="sidebar-link" href="@backUrl">
                        <h4><i class="fa fa-arrow-left"></i> Request No: @ServiceRequestNo</h4>
                    </a>
                    <span class="status-custom @statusClass" style="margin: 10px;">@detail?.Status</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card custom-card-according-title">

        @* ---------- Tabs ---------- *@
        <div class="tab-container sticky-header">
            <ul class="nav nav-tabs border-tab nav-info border-tab sticky" id="bottom-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link nav-border font-info tab-info active" id="MainInfo-tab" data-bs-toggle="tab"
                       href="#MainInfo-pane" role="tab" aria-controls="MainInfo-pane"
                       aria-selected="true" onclick="loadMainInfo()">
                        <i class="fa-solid fa-chart-pie"></i>Overview
                    </a>
                </li>

                @if (showDocumentsTab)
                {
                    <li class="nav-item" role="presentation">
                        <a class="nav-link nav-border font-info tab-info" id="UnitInfo-tab" data-bs-toggle="tab"
                           href="#UnitInfo-pane" role="tab" aria-controls="UnitInfo-pane"
                           aria-selected="false" onclick="loadDocuments()">
                            <i class="fa-solid fa-file-alt"></i>Documents
                        </a>
                    </li>
                }

                <li class="nav-item" role="presentation">
                    <a class="nav-link nav-border font-info tab-info" id="Payments-tab" data-bs-toggle="tab"
                       href="#Payments-pane" role="tab" aria-controls="Payments-pane"
                       aria-selected="false" onclick="loadCommunications()">
                        <i class="fa-solid fa-comments"></i>Communications
                    </a>
                </li>
            </ul>

            @* Main Info *@
            <div id="mainInfo" class="tab-content" style="background: transparent !important; color: inherit !important;">
                @await Html.PartialAsync("_MainInfoPartial", Model)
            </div>

            @* Documents *@
            @if (showDocumentsTab)
            {
                <div id="unitInfo" class="tab-content" style="background: transparent !important; color: inherit !important; height: 390px;">
                    @await Html.PartialAsync("_DocumentPartial", Model?.uploadDocResponse)
                </div>
            }

            @* Communications *@
            <div id="paymentInfo" class="tab-content">
                @await Html.PartialAsync("_CommunicationPartial", Model?.CoomunicationResponse)
            </div>
        </div>

        @* ---------- Modal: upload / replace document ---------- *@
        <div class="modal fade" id="uploadModel_" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">

                    <div class="modal-header bg-teal text-white">
                        <h5 class="modal-title" id="modalTitle" style="color:white">Replace — Document</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" name="uploadReqNo" id="uploadReqNo" />
                        <input type="hidden" name="uploadDocTypeId" id="uploadDocTypeId" />

                        <div class="mb-1 text-start">
                            <label class="form-label" style="display: contents;">Select a file for <strong id="docNameLabel">Document </strong> <span class="text-danger">*</span></label>
                            <input type="file" name="UploadFile" id="UploadFile" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                            <div class="form-text">Accepted: JPG, PNG, PDF · up to 10 MB</div>
                        </div>

                        @* Expiry date + upload button in one row *@
                        <div class="row align-items-end mb-1">
                            <div class="col-md-8 text-start">
                                <label class="form-label fw-semibold" style="margin-bottom: 0px;">
                                    Expiry Date <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input type="date"
                                           class="form-control expiryDate"
                                           id="expiryDateInput"
                                           name="expiryDateInput" />
                                </div>
                            </div>
                            <input type="hidden" name="isRejected" id="isRejected" />

                            <div class="col-md-4 d-flex align-items-end">
                                <button type="button" id="uploadBtn" onclick="submitUpload()" class="btn btn-primary w-100" disabled>
                                    Upload
                                </button>
                            </div>

                            @* Progress UI *@
                            <div id="progressContainer" class="progress mt-2" style="display:none; height: 20px;">
                                <div id="progressBar" class="progress-bar" role="progressbar" style="width: 0%; color: #43B9B2">
                                    0%
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @* ---------- Modal: survey success ---------- *@
        <div class="modal fade" id="surveySuccessModal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body success-modal-survey">
                        <div class="success-icon-survey">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h5 class="success-title-survey">
                            "Survey Completed"
                        </h5>
                        <p class="success-message-survey">
                            Thank you for completing the survey. Your feedback is valuable to us.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        @* ---------- Modal: delete confirmation ---------- *@
        <div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-3" style="padding: 30px;">

                    <div class="modal-header border-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <input type="hidden" name="uploadAttachmentId" id="uploadAttachmentId" />

                    <p class="mb-2 text-center">
                        Are you sure, you want to delete
                        <span id="uploadeddocName" class="fw-bold"><strong>File</strong></span>?
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <a class="btn btn-danger w-100 text-white"
                           href="#" onclick="removeDocument()" id="btn-delete">
                            Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Modal: Emirates ID sample ---------- *@
    <div class="modal fade" id="emirateIDSampleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-3">

                <div class="modal-header border-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <p style="margin: 10px">Please scan front & back side of your Emirates ID SEPARATELY as shown below</p>

                <div class="modal-body text-center">
                    <div style="max-height: 400px; overflow: hidden;">
                        <img src="~/assets/images/emiratesID.png"
                             alt="Emirate ID Sample"
                             class="img-fluid"
                             style="object-fit: contain; max-height: 350px;" />
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3 mb-2" style="margin-left: 20px; margin-right: 20px; margin-bottom: 15px">
                    <a class="btn btn-primary w-100 text-white"
                       href="#" onclick="openUploadEIDModal()" id="btn-next">
                        Next
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Modal: upload Emirates ID (front + back) ---------- *@
    <div class="modal fade" id="uploadModelEID_" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header bg-teal text-white">
                    <h5 class="modal-title" id="modalEIDTitle" style="color:white">Replace — Document</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="uploadEIDReqNo" id="uploadEIDReqNo" />
                    <input type="hidden" name="uploadEIDDocTypeId" id="uploadEIDDocTypeId" />
                    <input type="hidden" name="IDD" id="IDD" />

                    @* Front side *@
                    <div class="mb-2 text-start">
                        <label class="form-label" style="display: contents;">Select a Front Side for <strong id="docEIDNameLabel">Document </strong> <span class="text-danger">*</span></label>
                        <input type="file" name="UploadFile" id="UploadEIDFrontFile" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                    </div>

                    @* Back side *@
                    <div class="mb-1 text-start">
                        <label class="form-label" style="display: contents;">Select a Back Side for <strong id="docEIDNameLabel1">Document </strong> <span class="text-danger">*</span></label>
                        <input type="file" name="UploadFile" id="UploadEIDBackFile" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                        <div class="form-text mt-1">Accepted: JPG, PNG, PDF · up to 10 MB</div>
                    </div>

                    @* Expiry date + next button in one row *@
                    <div class="row align-items-end mb-1">
                        <div class="col-md-8 text-start">
                            <label class="form-label fw-semibold" style="margin-bottom: 0px;">
                                Expiry Date <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="date"
                                       class="form-control expiryDate"
                                       id="expiryEIDDateInput"
                                       name="expiryEIDDateInput" />
                            </div>
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" id="nextEIDBtn" onclick="openConfirmationEIDModal()" class="btn btn-primary w-100" disabled>
                                Next
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* ---------- Modal: confirm scanned Emirates ID data ---------- *@
    <div class="modal fade" id="confirmationModelEID_" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">

                <div class="modal-header bg-teal text-white">
                    <h5 class="modal-title" style="color:white">Confirm Data</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row align-items-end mb-1">

                        <p class="mb-1">Please Verify the below data specially dates</p>
                        <div class="mb-1" style="padding: 15px; text-align: left;">
                            <div class="form-group">
                                <label class="required">Name</label>
                                <input class="form-control" id="Name" />
                            </div>

                            <div class="form-group">
                                <label class="required">ID Number</label>
                                <input class="form-control" id="IDNumber" />
                            </div>

                            <div class="form-group">
                                <label class="required">Date of Birth</label>
                                <div class="input-group">
                                    <input type="date"
                                           class="form-control birthDate"
                                           id="DOBDate"
                                           name="DOBDate" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="required">Expiry Date</label>
                                <div class="input-group">
                                    <input type="date"
                                           class="form-control expiryDate"
                                           id="ExpiryDateConfirmation"
                                           name="ExpiryDateConfirmation" />
                                </div>
                            </div>

                            <div class="form-group" style="display:none">
                                <label>Issuing Date</label>
                                <div class="input-group">
                                    <input type="date"
                                           class="form-control expiryDate"
                                           id="IssuingDate"
                                           name="IssuingDate" />
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="required">Nationality</label>
                                <input class="form-control" id="Nationality" />
                            </div>

                            <div class="form-group">
                                <label>Sex</label>
                                <input class="form-control" id="Sex" />
                            </div>
                        </div>

                        <div class="row mb-1 justify-content: center;">
                            <div></div>
                            <canvas id="mergedCanvas" style="display:none"></canvas>
                            <img id="mergedImage" style="width: 200px" />
                            <div></div>
                        </div>
                        <input type="hidden" name="isRejectedEID" id="isRejectedEID" />

                        <div class="col-md-12 d-flex align-items-end mt-1">
                            <button type="button" id="uploadEIDBtn" onclick="submitUploadEID()" class="btn btn-primary w-100">
                                Upload
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* ---------- Modal: documents submitted (stage updated) ---------- *@
    <div class="modal fade" id="stageConfirmationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-3" style="padding: 30px;">

                <div class="modal-header border-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <img src="~/assets/images/bluetick.png"
                     alt="Check"
                     class="img-fluid"
                     style="object-fit: contain; max-height: 113px; padding-bottom: 10px;" />

                <label><strong>Documents submitted successfully</strong></label>
                <p class="mb-4">
                    The documents have been successfully submitted. You will be notified within 2 working days once the verification is completed by the FABP team.
                </p>

                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-primary text-white" onclick="closeConfirmationModel()">Back</button>
                    <button type="button" class="btn btn-primary" onclick="cancelConfirmationModel()" aria-label="Close">Stay on Page</button>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" id="photoID" />

    @* ---------- Full page loaders ---------- *@
    <div id="fullPageLoader" style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0,0,0,0.5);
                    z-index: 99999;
                    display: none;
                    justify-content: center;
                    align-items: center;
                    text-align: center;
                    font-size: 20px;
                    color: white;
