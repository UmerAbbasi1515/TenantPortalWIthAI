    function downloadPdf(base64StringFromAPI) {
        const base64String = base64StringFromAPI;
        const byteCharacters = atob(base64String);
        const byteNumbers = Array.from(byteCharacters, c => c.charCodeAt(0));
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: 'application/pdf' });

        // Open in a new tab (preview) and also download
        const blobUrl = URL.createObjectURL(blob);
        const newTab = window.open(blobUrl, "_blank");
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'file.pdf';
        link.click();

        URL.revokeObjectURL(link.href);
    }

    function downloadImage(base64StringFromAPI) {
        const base64String = base64StringFromAPI;
        const byteCharacters = atob(base64String);
        const byteNumbers = Array.from(byteCharacters, c => c.charCodeAt(0));
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: 'image/png' });

        // Open in a new tab (preview) and also download
        const blobUrl = URL.createObjectURL(blob);
        const newTab = window.open(blobUrl, "_blank");

        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'file.jpg';
        link.click();

        URL.revokeObjectURL(link.href);

        // Cleanup after a short delay (give the browser time to load)
        setTimeout(() => {
            URL.revokeObjectURL(blobUrl);
        }, 3000);
    }

    function resetProgress(progressContainer, progressBar) {
        progressBar.style.width = "0%";
        progressBar.innerText = "0%";
        progressContainer.style.display = "none";
    }

    // Reload the Documents tab content
    function reloadTab2(caseNo) {
        showLoader();

        // Allow the browser to repaint the loader first
        setTimeout(() => {
            fetch(`/ServiceRequests/ServiceRequest/_ServiceRequestDocuments?caseNo=${caseNo}`)
                .then(r => {
                    if (!r.ok) throw new Error("Failed to reload partial");
                    return r.text();
                })
                .then(html => {
                    const tab2 = document.getElementById('unitInfo');
                    if (!tab2) {
                        console.error("Tab2Container not found in DOM!");
                        return;
                    }
                    tab2.innerHTML = html;
                })
                .catch(err => {
                    toastr.error("Reload failed");
                    console.error(err);
                })
                .finally(() => {
                    hideLoader();
                });
        }, 0);
    }</script>

