@* =====================================================================
    SCRIPTS SECTION (rendered by the layout)
    Emirates ID number formatting + tab loading (Overview / Documents / Communications)
    ===================================================================== *@
@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>
    <script>// Auto-format Emirates ID number while typing (xxx-xxxx-xxxxxxx-x)
        $('#IDNumber').on('input', function () {
            let value = $(this).val().replace(/[^0-9]/g, ''); // Remove non-digits

            if (value.length > 0) {
                let formatted = '';
                if (value.length <= 3) {
                    formatted = value;
                } else if (value.length <= 7) {
                    formatted = value.slice(0, 3) + '-' + value.slice(3);
                } else if (value.length <= 14) {
                    formatted = value.slice(0, 3) + '-' + value.slice(3, 7) + '-' + value.slice(7);
                } else {
                    formatted = value.slice(0, 3) + '-' + value.slice(3, 7) + '-' + value.slice(7, 14) + '-' + value.slice(14, 15);
                    value = value.slice(0, 15); // Limit to 15 digits
                }
                $(this).val(formatted);
            }
        });</script>

    <script>
        var caseNo = '@ViewData["ServiceReqNoTitle"]';
        var documentsLoaded = false;
        var communicationsLoaded = false;
        var communicationRefreshInterval;

        // Show one tab, hide the others
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(function (tab) {
                tab.style.display = 'none';
                tab.classList.remove('active');
            });

            var selectedTab = document.getElementById(tabId);
            if (selectedTab) {
                selectedTab.style.display = 'block';
                selectedTab.classList.add('active');
            }

            document.querySelectorAll('.nav-link').forEach(function (link) {
                link.classList.remove('active');
            });
        }

        // Overview tab (already rendered on page load)
        function loadMainInfo() {
            showLoader();
            showTab('mainInfo');
            document.getElementById('MainInfo-tab').classList.add('active');

            // Stop communication refresh if running
            stopCommunicationRefresh();
            hideLoader();
        }

        // Documents tab (loaded only once)
        async function loadDocuments() {
            showLoader();
            showTab('unitInfo');
            document.getElementById('UnitInfo-tab').classList.add('active');

            if (!documentsLoaded) {
                try {
                    const response = await fetch('/ServiceRequests/ServiceRequest/_ServiceRequestDocuments?caseNo=' + caseNo);
                    if (response.ok) {
                        const html = await response.text();
                        document.getElementById('unitInfo').innerHTML = html;
                        documentsLoaded = true;
                    } else {
                        document.getElementById('unitInfo').innerHTML =
                            '<div class="alert alert-danger">Error loading documents. Please try again.</div>';
                    }
                } catch (error) {
                    console.error('Error loading documents:', error);
                    document.getElementById('unitInfo').innerHTML =
                        '<div class="alert alert-danger">Error loading documents: ' + error.message + '</div>';
                }
            }
            hideLoader();
        }

        // Communications tab (always refreshed to get the latest messages)
        async function loadCommunications() {
            showLoader();
            showTab('paymentInfo');
            document.getElementById('Payments-tab').classList.add('active');

            await refreshCommunications();

            // Start auto-refresh
            startCommunicationRefresh();
            hideLoader();
        }

        // Refresh only the chat container so the rest of the tab is untouched
        async function refreshCommunications() {
            try {
                const response = await fetch('/ServiceRequests/ServiceRequest/_ServiceRequestCommunications?caseNo=' + caseNo);

                if (response.ok) {
                    const html = await response.text();

                    // Parse the response and extract only the ChatContainer HTML
                    const tempDiv = document.createElement("div");
                    tempDiv.innerHTML = html;

                    const newChat = tempDiv.querySelector("#ChatContainer");
                    const oldChat = document.getElementById("ChatContainer");

                    if (!newChat || !oldChat) return;

                    // Check scroll position before update
                    const isNearBottom = oldChat.scrollTop + oldChat.clientHeight >= oldChat.scrollHeight - 50;

                    // Replace ChatContainer content only
                    oldChat.innerHTML = newChat.innerHTML;

                    // Restore scroll
                    if (!communicationsLoaded || isNearBottom) {
                        oldChat.scrollTop = oldChat.scrollHeight;
                    }

                    communicationsLoaded = true;
                }
            } catch (error) {
                console.error("Error loading communications:", error);
            }
        }

        // Auto-refresh communications (every 2 seconds)
        function startCommunicationRefresh() {
            stopCommunicationRefresh(); // clear any existing interval

            communicationRefreshInterval = setInterval(function () {
                refreshCommunications();
            }, 2000);

            console.log('Communication auto-refresh started');
        }

        function stopCommunicationRefresh() {
            if (communicationRefreshInterval) {
                clearInterval(communicationRefreshInterval);
                communicationRefreshInterval = null;
                console.log('Communication auto-refresh stopped');
            }
        }

        // Initial tab selection based on the SelectedTab value from the server
        document.addEventListener("DOMContentLoaded", function () {
            var selectedTab = @(ViewData["SelectedTab"] ?? 1);

            if (selectedTab === 1) {
                loadMainInfo();
            } else if (selectedTab === 2) {
                loadDocuments();
            } else if (selectedTab === 3) {
                loadCommunications();
            } else {
                loadMainInfo(); // default
            }
        });

        // Stop refresh when the user leaves the page
        window.addEventListener('beforeunload', function () {
            stopCommunicationRefresh();
        });

        // Pause refresh when the browser tab is hidden
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) {
                stopCommunicationRefresh();
            } else {
                // Resume if the communication tab is active
                var commTab = document.getElementById('paymentInfo');
                if (commTab && commTab.classList.contains('active')) {
                    startCommunicationRefresh();
                }
            }
        });
    </script>
}

