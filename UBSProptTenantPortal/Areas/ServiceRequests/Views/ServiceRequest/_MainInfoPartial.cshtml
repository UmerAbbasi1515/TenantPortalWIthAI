@using UBSProptTenantPortal
@model SrReqDetailMainDocumentCommunication
@{

    var photos = Model?.mainInfo?.reqPhotos;
    var  status1 = Model?.mainInfo?.Detail?.Status;
    string alreadyCancelled = (status1 ?? "")
                  .ToString()
                  .Trim()
                  .ToLower();

}
<style>
    .stars i {
        font-size: 1.2rem;
        margin-right: 2px;
    }

    .stars-interactive i {
        font-size: 2rem;
        margin-right: 5px;
        cursor: pointer;
        transition: color 0.2s;
    }

        .stars-interactive i:hover,
        .stars-interactive i.active {
            color: #43B9B2 !important;
        }

        .stars-interactive i.fas {
            color: #43B9B2;
        }

        .stars-interactive i.far {
            color: #ddd;
        }
</style>
@if (ViewBag.errorMainInfo != "")
{
    <div class="card-header pb-0" style="flex-shrink: 0;">
        <center style="padding-top: 50px;">
            <h4 style="padding-top: 5px;">@ViewBag.errorMainInfo</h4>
        </center>
        <i class="fa fa-refresh" aria-hidden="true" style="padding-top: 5px; font-size: 18px; color: black;"
           onclick="window.location.href = '@Url.Action("ServiceRequests", "ServiceRequest" , new { area = "ServiceRequests" })'"></i>
    </div>
}
else
{
    var detail = Model?.mainInfo?.Detail;
    var contractInfo = Model?.mainInfo?.ContractInfo;
    var statusInfo = Model?.mainInfo?.StatusInfo;
    var stageInfo = Model?.mainInfo?.StageInfo;
    string statusClass = LabelsTenantPortal.GetStatusCssClass(detail?.Status ?? "");
    string status = (detail?.Status ?? "")
             .ToString()
             .Trim()
             .ToLower();
    var alreadyCancelledClosed = (status == "closed" || status == "cancelled");

    <div style="background-color: white !important;">
        <div class="property-details">

            <!-- Request Details -->
            <div class="row alert alert-light-primary subtitle" role="alert">
                <div class="col-sm-6">
                    <h5 style="text-align: left; padding-left: 20px;">Request Details</h5>
                </div>
            </div>

            <div class="property-details-row">
                <div class="col-md-3" style="text-align: left;">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa fa-layer-group"></i> <span>Category</span>
                    </div>
                    <p class="p-style"><strong>@detail?.Category</strong></p>
                </div>

                <div class="col-md-3" style="text-align: left;">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa fa-list-ul"></i> <span>Sub Category</span>
                    </div>
                    <p class="p-style"><strong>@detail?.SubCategory</strong></p>
                </div>

                <div class="col-md-3" style="text-align: left;">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa fa-calendar"></i> <span>Property</span>
                    </div>
                    <p class="p-style"><strong>@detail?.PropertyName</strong></p>
                </div>

                <div class="col-md-3" style="text-align: left;">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa fa-calendar"></i> <span>Date</span>
                    </div>
                    <p class="p-style"><strong>@detail?.Date</strong></p>
                </div>
            </div>

            <!-- Contract Info -->
            <div class="row alert alert-light-primary subtitle" role="alert">
                <div class="col-sm-6">
                    <h5 style="text-align:left; padding-left:20px;">Contract Info</h5>
                </div>
            </div>

            <div class="property-details-row" style="text-align:left;">
                <div class="col-md-3">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa fa-building"></i> <span>Property</span>
                    </div>
                    <p class="p-style"><strong>@contractInfo?.PropertyName</strong></p>
                </div>

                <div class="col-md-3">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa fa-file-contract"></i> <span>Contract No</span>
                    </div>
                    <p class="p-style"><strong>@contractInfo?.Contractno</strong></p>
                </div>

                <div>
                    <span class="status-custom @statusClass" style="margin: 10px;">@detail?.Status</span>
                </div>
            </div>

            <!-- Contract Personal Details -->
            <div class="row alert alert-light-primary subtitle" role="alert">
                <div class="col-sm-6">
                    <h5 style="text-align:left; padding-left:20px;">Contract Personal Details</h5>
                </div>
            </div>

            <div class="property-details-row" style="text-align:left;">
                <div class="col-md-3">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa-solid fa-user"></i> <span>Name</span>
                    </div>
                    <p class="p-style"><strong>@detail?.unitRefNoOtherContactPersonName</strong></p>
                </div>

                <div class="col-md-3">
                    <div style="display:flex; align-items:center; gap:6px;">
                        <i class="fa-solid fa-phone"></i> <span>Phone Number</span>
                    </div>
                    <p class="p-style"><strong>@detail?.otherContactPersonMobile</strong></p>
                </div>
                @if (@ViewBag.TabName == "FM")
                {<div class="col-md-3">
                        <div style="display:flex; align-items:center; gap:6px;">
                            <i class="fa-solid fa-clock"></i> <span>Contact Time</span>
                        </div>
                        <p class="p-style"><strong>@detail?.ContactTiming</strong></p>
                    </div>}

            </div>

            <!-- Description -->
            <div class="row alert alert-light-primary subtitle" role="alert">
                <div class="col-sm-6">
                    <h5 style="text-align:left; padding-left:20px;">Description</h5>
                </div>
            </div>

            <div class="col-md-12" style="text-align:left;">
                <p>@detail?.Description</p>
            </div>

        </div>
    </div>

    <!-- Feedback -->
    @if (Model?.mainInfo?.feedback?.Feedback?.Rating! != 0 && Model?.mainInfo?.feedback?.Feedback != null)
    {
        <div class="card shadow-sm mb-3 mt-3">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2" style="text-align: left;">
                    <span class="me-2"><strong>Rating:</strong></span>
                    <div class="stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var feedback = Model?.mainInfo?.feedback?.Feedback;
                            @if (i <= feedback?.Rating)
                            {
                                <i class="fas fa-star text-primary"></i>
                            }
                            else
                            {
                                <i class="far fa-star text-primary"></i>
                            }
                        }
                    </div>
                    <span class="ms-2 text-muted">(@Model?.mainInfo?.feedback?.Feedback?.Rating?.ToString("0.0"))</span>
                </div>

                @if (!string.IsNullOrEmpty(Model?.mainInfo?.feedback?.Feedback?.Description))
                {
                    <div class="mt-3" style="text-align: left;">
                        <p class="mb-1"><strong>Description:</strong></p>
                        <p class="text-muted">@Model?.mainInfo?.feedback?.Feedback?.Description</p>
                    </div>
                }


            </div>
        </div>
    }

    <!-- Add Feedback Form -->
    <div class="card shadow-sm mb-3 mt-3" id="feedbackContainer" style="display:none">
        <div class="card-body">
            <h5 class="card-title mb-3">Add Your Feedback</h5>

            <form id="feedbackForm">

                <div class="mb-3" style="text-align: left;">
                    <label class="form-label"><strong>Rate your experience:</strong></label>
                    <div class="rating-input">
                        <input type="hidden" id="ratingValue" name="Rating" value="0" required />
                        <div class="stars-interactive" id="starsRating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="far fa-star" data-rating="@i"></i>
                            }
                        </div>
                    </div>
                    <small class="text-danger" id="ratingError" style="display: none;">Please select a rating</small>
                </div>

                <div class="mb-3" style="text-align: left;">
                    <label for="description" class="form-label"><strong>Description:</strong></label>
                    <textarea class="form-control" id="description" name="Description"
                              rows="4" placeholder="Tell us about your experience..."></textarea>
                    <small class="text-danger" id="descriptionError" style="display: none;">Please enter description</small>
                </div>

                <div class="row  justify-content-center">
                    <button type="button" onclick="hideFeedback()" class="btn btn-danger" style="width:300px">Cancel</button>
                    <div style="width: 70px"></div>
                    <button type="button" onclick="feedbackDataValues()" class="btn btn-primary" style="width: 300px">Submit Feedback</button>
                </div>
            </form>
        </div>
    </div>

    @* Report*@
    @if (Model?.mainInfo?.reqReport != null && Model?.mainInfo?.reqReport.Count > 0)
    {
        <div class="row alert alert-light-primary subtitle" role="alert" style=" margin-top: 10px; margin-bottom: 10px; margin-left: 1px; margin-right: 1px;">
            <div class="col-sm-6">
                <h5 style="text-align: left; padding-left: 20px;">Report</h5>
            </div>
        </div>
        var doc = Model?.mainInfo?.reqReport?[0];
        var base64File = doc?.Path;

        <div class="text-center col-md-4">
            <div class="border rounded-3 p-3 mt-2 d-flex justify-content-between align-items-center"
                 style="border: 1px solid #cfd4da; background-color: #f8f9fc; cursor: pointer;"
                 onclick='downloadDocument("@base64File")'>

                <div class="fw-semibold text-start d-flex align-items-center">
                    <i class="fa fa-file" style="font-size: 18px; color: #43B9B2;"></i>
                    <span class="ms-2"><strong>@doc?.Name</strong></span>
                </div>
                <p>@doc?.Size</p>
                <div>
                    <i class="fa fa-download" style="font-size: 18px; color: #43B9B2;" onclick="downloadImage(@base64File);"></i>
                </div>
            </div>
        </div>
    }


    @* Photos*@
    <!-- ✅ Photos Grid -->

    @if (@ViewBag.TabName == "FM")
    {
        <!-- ✅ Upload Photos Header -->
        <div class="row alert alert-light-primary subtitle mt-4" role="alert">
            <div class="col-sm-6">
                <h5 class="ps-3" style="text-align: start">Upload Photos</h5>
            </div>
        </div>

        <!-- ✅ Photos Grid -->
<div class="d-flex flex-wrap gap-2">
    @if (photos != null && photos.Any())
    {
        foreach (var photo in photos)
        {
            var imageSrc = photo?.photoSource;
            var photoID = photo?.photoId;
                    <div class="position-relative m-1 border rounded"
                         style="width: 100px; height: 100px; overflow: hidden;">
                        <a href="javascript:void(0)"
                           onclick="downloadDocument('@photoID','@detail?.CaseNo','png',0)">
                            <img src="@imageSrc"
                                 alt="photo"
                                 width="100"
                                 height="100"
                                 style="object-fit: cover; padding-top : 20px"
                                 class="rounded" />
                        </a>
                        @if (status == "cancelled") { }
                        else
                        {
                            <a href="javascript:void(0)"
                               onclick="showPopupDelete('@photoID')"
                               class="position-absolute"
                               style="top: 1px; right: 1px;">

                                <i class="fa fa-times-circle text-danger" style="font-size: 20px;"></i>
                            </a>
                        }
                    </div>
        }
    }
    else
    {
        @if (alreadyCancelledClosed == true)
        {
            <div class="text-center col-md-4" style="margin-bottom: 15px">
                <div class="border rounded-3 p-3"
                     style="background-color: #f8f9fc; border: 1px solid #ffeeba;">
                    <i class="fa fa-info-circle text-warning"></i>
                    <span class="fw-semibold ms-2">No Photo found.</span>
                </div>
            </div>
        }
    }
    <!-- Add New Photo -->
    @if (alreadyCancelledClosed != true)
    {
        <div class="m-1 border rounded d-flex justify-content-center align-items-center"
             style="width: 100px; height: 100px; cursor: pointer; background-color: #f8f9fc;"
             onclick="document.getElementById('photoInput').click();">
            <i class="fa fa-plus text-primary" style="font-size: 24px;"></i>
        </div>

        <input type="file" id="photoInput" accept="image/*" class="d-none" onchange="uploadPhoto('0', 'Images')" />
    }

</div>

    }

    //Survey
    <div id="surveyContainer"></div>
    <hr />


    <div class="row">
        @if (Model?.mainInfo?.StatusInfo?.CanTakeSurvey == true && Model?.mainInfo?.surveyQAs?.FaqQuestion != null)
            {
            <button class="btn btn-primary btn-block text-white  mt-3 mb-3"
                    onclick="loadSurvey()" style="width: 300px !important " id="surveybuttonId">
                Survey
            </button>
        }
        <div style="width: 70px"></div>
        @if (ViewBag.CallingFrom == "Renewal")
        {
            if (Model?.mainInfo?.feedback?.Feedback == null && Model?.mainInfo?.feedback?.Feedback?.Rating == 0.0 || Model?.mainInfo?.feedback?.Feedback?.Rating == null)
            {
                <button class="btn btn-primary btn-block text-white  mt-3 mb-3"
                        onclick="loadFeedback()" style="width: 300px !important " id="feedbackButton">
                    Feedback
                </button>
            }

        }
        else
        {
            if (Model?.mainInfo?.StatusInfo?.CanAddFeedback == true)
            {
                <button class="btn btn-primary btn-block text-white  mt-3 mb-3"
                        onclick="loadFeedback()" style="width: 300px !important " id="feedbackButton">
                    Feedback
                </button>
            }
        }

    </div>

    @if (statusInfo?.CanCancel == true && stageInfo?.StageId < 4)
    {
        <button class="btn btn-outline-danger  mt-3 mb-3"
                onclick="showPopup()" style=" width: 500px">
            Cancel request
        </button>
    }


    <input type="hidden" id="photoID" style="color:red" />
    <!-- Cancel Modal -->
    <div id="cancelModal" class="cancel-modal">
        <div class="cancel-modal-content">
            <!-- Close button (X) -->
            <span class="close-modal" onclick="closePopup()">&times;</span>

            <h3 style="margin-top: 0;">Are you sure you want to cancel this request?</h3>
            <button class="btn btn-outline-danger  mt-3" style="background-color: red;" onclick="CancelServiceRequestDetail()">Cancel</button>

        </div>
    </div>

    <!-- Delete Photo Modal -->
    <div id="deleteModal" class="cancel-modal">
        <div class="cancel-modal-content">
            <!-- Close button (X) -->
            <span class="close-modal" onclick="closePopupDelete()">&times;</span>

            <h3 style="margin-top: 0;">Are you sure you want to delete this photo?</h3>

            <button class="btn btn-outline-danger  mt-3" style="background-color: red;" onclick="deletePhoto()">Delete</button>
        </div>
    </div>


}