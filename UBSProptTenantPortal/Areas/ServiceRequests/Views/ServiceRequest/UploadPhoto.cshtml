@model List<PhotoFileTen?>
@{
    ViewData["Title"] = "Upload Photos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string caseNo = ViewBag.caseNo;
}

<style>
    /* ---------- Delete modal ---------- */
    .cancel-modal {
        display: none;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .cancel-modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        padding: 30px;
        border: 1px solid #888;
        border-radius: 8px;
        width: 90%;
        max-width: 400px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        position: relative;
    }

        .cancel-modal-content button {
            margin: 5px;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

            .cancel-modal-content button:first-of-type {
                background-color: #43B9B2;
                color: white;
            }

            .cancel-modal-content button:hover {
                opacity: 0.8;
            }

    .close-modal {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        line-height: 20px;
        cursor: pointer;
    }

        .close-modal:hover,
        .close-modal:focus {
            color: #000;
        }

    /* ---------- Photos ---------- */
    .photo-container {
        display: inline-block;
        transition: transform 0.2s;
    }

        .photo-container:hover {
            transform: scale(1.05);
        }

    .delete-btn {
        background-color: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        padding: 2px;
        transition: background-color 0.2s;
    }

        .delete-btn:hover {
            background-color: rgba(255, 255, 255, 1);
        }
</style>

@* ---------- Page header ---------- *@
<div class="card pageheader" style="box-shadow: none;">
    <div class="card-header">
        <div class="row">
            <div class="col-12 text-start" style="display:flex; flex-direction:row; justify-content:space-between">
                <a class="sidebar-link" href="@(Url.Action("ServiceRequests", "ServiceRequest", new { area = "ServiceRequests", tab = "FM" }))">
                    <h4><i class="fa fa-arrow-left"></i> Upload Photos</h4>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card">

    <div class="card-body">

        @* ---------- Photos grid ---------- *@
        <div class="d-flex flex-wrap gap-2">
            @if (Model != null && Model.Any())
            {
                foreach (var photo in Model)
                {
                    var imageSrc = photo?.photoSource;
                    var photoID = photo?.photoId;

                    <div class="position-relative m-1 border rounded"
                         style="width: 100px; height: 100px; overflow: hidden;">
                        <center>
                            <a href="javascript:void(0)"
                               onclick="downloadDocument('@photoID','@caseNo','png',0)">
                                <img src="@imageSrc"
                                     alt="photo"
                                     width="100"
                                     height="100"
                                     style="object-fit: cover; margin-top: 30px"
                                     class="rounded" />
                            </a>
                        </center>
                        <a href="javascript:void(0)"
                           onclick="showPopupDelete('@photoID')"
                           class="position-absolute"
                           style="top: 2px; right: 2px;">
                            <i class="fa fa-times-circle text-danger" style="font-size:20px"></i>
                        </a>
                    </div>
                }
            }

            @* Add photo tile *@
            <div class="m-1 border rounded d-flex justify-content-center align-items-center"
                 style="width: 100px; height: 100px; cursor: pointer; background-color: #f8f9fc;"
                 onclick="document.getElementById('photoInput').click();">
                <i class="fa fa-plus text-primary" style="font-size: 24px;"></i>
            </div>

            <input type="file" id="photoInput" accept="image/*" class="d-none"
                   onchange="uploadPhoto('0', 'Images', '@caseNo')" />
        </div>

        @* ---------- Submit button ---------- *@
        <div class="col-md-12 d-flex align-items-end mt-1" style="width: 50%; padding-top: 10px; margin-left: 30%; padding-bottom: 10px">
            <button type="button"
                    id="uploadEIDBtn"
                    onclick="window.location.href='@Url.Action("ServiceRequestDetailN", "ServiceRequest", new { area = "ServiceRequests", caseNo = caseNo, tab = "FM", callingFrom = "newReq" })';"
                    class="btn btn-primary w-100">
                Submit Request
            </button>
        </div>

    </div>

    <input type="hidden" id="photoID" />

    @* ---------- Full page loader ---------- *@
    <div id="fullPageLoader" style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0,0,0,0.5);
                    z-index: 99999;
                    display: none;
                    justify-content: center;
                    align-items: center;
                    text-align: center;
                    font-size: 20px;
                    color: white;
                ">
        <div>
            <div class="spinner-border text-light" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div style="margin-top: 15px;">Loading...</div>
        </div>
    </div>

    @* ---------- Delete photo modal ---------- *@
    <div id="deleteModal" class="cancel-modal">
        <div class="cancel-modal-content">
            <span class="close-modal" onclick="closePopupDelete()">&times;</span>

            <h3 style="margin-top: 30px;">Are you sure you want to delete this photo?</h3>

            <center>
                <button class="btn btn-outline-danger mt-3" style="background-color: red;" onclick="deletePhoto()">Delete</button>
            </center>
        </div>
    </div>

</div>

<script src="~/toaster/toaster.js"></script>

<script>
    // Used when no case number is passed to downloadDocument
    var caseNo1 = '@caseNo';

    // =====================================================================
    // Helpers
    // =====================================================================

    // Reads a fetch Response body once and never throws on empty / non-JSON bodies.
    async function readJsonSafely(response, fallback = {}) {
        try {
            const text = await response.text();
            return text ? JSON.parse(text) : fallback;
        } catch (error) {
            console.error('Invalid JSON response:', error);
            return fallback;
        }
    }

    function showLoader() {
        const loader = document.getElementById('fullPageLoader');
        if (loader) loader.style.display = 'flex';
    }

    function hideLoader() {
        const loader = document.getElementById('fullPageLoader');
        if (loader) loader.style.display = 'none';
    }

    // =====================================================================
    // Upload photo
    // =====================================================================
    async function uploadPhoto(documentTypeID, attachementType, caseNo) {
        showLoader();
        const fileInput = document.getElementById('photoInput');
        const expiryDate = "";

        if (!fileInput.files.length) {
            toastr.warning("Please select a photo.");
            hideLoader();
            return;
        }

        const file = fileInput.files[0];
        const formData = new FormData();
        formData.append("caseNo", caseNo);
        formData.append("expiry", expiryDate);
        formData.append("attachementType", attachementType);
        formData.append("documentTypeId", documentTypeID);
        formData.append("file", file);

        try {
            const response = await fetch('/ServiceRequests/ServiceRequest/ServiceRequestUploadReportDoc', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const result = await readJsonSafely(response);
                if (result.success) {
                    toastr.success("Photo Uploaded successfully");
                } else {
                    toastr.error("Upload failed: " + result.message);
                }
            } else {
                const errorText = await response.text();
                toastr.error("Server error: " + errorText);
            }
        } catch (error) {
            toastr.error("Network error: " + error);
        } finally {
            window.location.reload();
            hideLoader();
        }
    }

    // =====================================================================
    // Delete photo
    // =====================================================================
    window.showPopupDelete = function (photoId) {
        console.log("Photo ID:", photoId);

        document.getElementById('photoID').value = photoId;
        document.getElementById('deleteModal').style.display = 'block';
    };

    window.closePopupDelete = function () {
        document.getElementById('deleteModal').style.display = 'none';
    };

    // Delete photo with confirmation
    async function deletePhoto() {
        showLoader();

        var photoID = document.getElementById('photoID').value;
        const formData = new FormData();
        formData.append("PhotoId", photoID);

        try {
            const response = await fetch('/ServiceRequests/ServiceRequest/ServiceRequestDeleteReportDoc', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const result = await readJsonSafely(response);
                if (result.success) {
                    toastr.success("Photo deleted successful");
                    closePopupDelete();
                } else {
                    toastr.error("Photo deleted failed: " + result.message);
                    closePopupDelete();
                }
            } else {
                const errorText = await response.text();
                toastr.error("Server error: " + errorText);
            }
        } catch (error) {
            toastr.error("Server error: " + error);
        } finally {
            window.location.reload();
            hideLoader();
        }
    }

    // =====================================================================
    // Download photo
    // =====================================================================
    async function downloadDocument(attachmentId, reqNo, extentsion, index) {
        showLoader();
        var id = "btnDownload_" + index;
        if (reqNo == "") {
            reqNo = caseNo1;
        }
        btnshowLoader(id);

        const data = {
            CaseNo: reqNo.toString(),
            RoleId: "1",
            PhotoId: attachmentId.toString()
        };
        try {
            const response = await fetch('/ServiceRequests/ServiceRequest/ServiceRequestDownloadDocuments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                btnhideLoader(id);
                const data1 = await readJsonSafely(response);
                if (data1.path) {
                    if (extentsion == "png" || extentsion == "jpg" || extentsion == "jpeg") {
                        downloadImage(data1.path);
                    } else {
                        downloadPdf(data1.path);
                    }
                } else {
                    toastr.error("Download failed: base64 path not found");
                }
            } else {
                btnhideLoader(id);
                toastr.error("Download failed: " + response.statusText);
            }
        } catch (error) {
            btnhideLoader(id);
            toastr.error("Download failed: " + error);
        } finally {
            hideLoader();
        }
    }

    function downloadPdf(base64StringFromAPI) {
        const base64String = base64StringFromAPI;
        const byteCharacters = atob(base64String);
        const byteNumbers = Array.from(byteCharacters, c => c.charCodeAt(0));
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: 'application/pdf' });

        // Open in a new tab (preview) and also download
        const blobUrl = URL.createObjectURL(blob);
        const newTab = window.open(blobUrl, "_blank");
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'file.pdf';
        link.click();

        URL.revokeObjectURL(link.href);
    }

    function downloadImage(base64StringFromAPI) {
        const base64String = base64StringFromAPI;
        const byteCharacters = atob(base64String);
        const byteNumbers = Array.from(byteCharacters, c => c.charCodeAt(0));
        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: 'image/jpeg' });

        // Open in a new tab (preview) and also download
        const blobUrl = URL.createObjectURL(blob);
        const newTab = window.open(blobUrl, "_blank");

        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'file.jpg';
        link.click();

        URL.revokeObjectURL(link.href);

        // Cleanup after a short delay (give the browser time to load)
        setTimeout(() => {
            URL.revokeObjectURL(blobUrl);
        }, 3000);
    }
</script>
