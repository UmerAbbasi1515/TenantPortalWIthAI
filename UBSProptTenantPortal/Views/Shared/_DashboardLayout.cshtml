                                <div class="d-flex align-items-center">
                                    <a href="javascript:void(0)" id="profileID">
                                        <div class="flex-grow-1 @directionClass">
                                            <h5>@userNameEng</h5>
                                            <span>@email</span>
                                        </div>
                                    </a>
                                </div>
                                <div class="custom-menu overflow-hidden">
                                    <ul style="margin-right: 20px;">
                                        <li>
                                            <a class="ms-2"> <i class="fa fa-user" aria-hidden="true"></i></a>
                                            <a class="ms-2" href="@Url.Action("Profile", "Profile", new { area = "Profile" })">
                                                <span>@LabelsTenantPortal.profile</span>
                                            </a>
                                        </li>
                                        <li style="align-items: center;">
                                            <a class="ms-2"> <i class="fa fa-sign-out" aria-hidden="true"></i></a>
