                                <a class="sidebar-link @(ViewContext.RouteData?.Values?["action"]?.ToString() == "Profile" ? "active" : "")"
                                   href="@Url.Action("Profile", "Profile", new { area = "Profile" })">
                                    <span><i class="fa fa-user"></i> <strong>Profile</strong></span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </aside>

                <!-- Main Content -->
                <div class="page-body" style="margin: 0 -7px 0 0;">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    </main>

    <!-- jquery-->
    <script src="/assets/js/vendors/jquery/dist/jquery.min.js"></script>

    <!-- bootstrap js-->
    <script src="/assets/js/vendors/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="/assets/js/config.js"></script>
    <!-- Sidebar js-->
    <script src="/assets/js/sidebar.js"></script>

    <script src="/assets/js/datepicker/custom-datepicker.js"></script>
    <!-- Height-equal js-->
    <script src="/assets/js/height-equal.js"></script>
    <!-- scrollbar js-->
    <script src="/assets/js/scrollbar/simplebar.js"></script>
    <script src="/assets/js/scrollbar/custom.js"></script>
    <!-- scrollable-->
    <!-- Flatpicker js-->
    <script src="/assets/js/vendors/flatpickr/dist/flatpickr.min.js"></script>
    <script src="/assets/js/custom-flatpickr.js"></script>
    <!-- custom script -->
    <script src="/assets/js/script.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/select2.min.js"></script>
    <script src="~/toaster/toaster.js"></script>
    <!-- customizer-->
    <script src="/assets/js/theme-customizer/customizer.js" asp-append-version="true"></script>

    <script src="~/assets/js/datatable/datatables/jquery.dataTables.min.js"></script>

    <script src="~/js/custom.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/jquery.unobtrusive-ajax.js" type="text/javascript"></script>
    <!-- Tooltip js-->
    <script src="~/assets/js/tooltip-custom.js"></script>
    <!-- custom validators js-->
    <script src="~/js/customvalidators.js"></script>
    @*for assistant*@
    <script src="~/js/assistant.js" asp-append-version="true"></script>


    @* All Scripts  *@
    <script>
        // Close/Open side menu
        document.addEventListener('DOMContentLoaded', () => {
            const closeButton = document.getElementById('close-btn');
            const mainBody = document.getElementById('mainBodyID');
            const sidebar = document.getElementById('page-sidebar');
            const menuBtn = document.getElementById('toggle-sidebar');

            closeButton.addEventListener('click', () => {
                sidebar.classList.toggle('hidden');
                if (sidebar.classList.contains('hidden')) {
                    // Sidebar is hidden, show menu icon and hide back arrow
                    menuBtn.classList.add('close');
                    var language = "{{@AuthLabelsPortal.language}}";
                    if (language == "{{English}}") {
                        mainBody.classList.add('sidemenuEnglish11');
                        mainBody.classList.remove('sidemenuEnglish');
                    } else {
                        mainBody.classList.add('sidemenuArabicWithFullWidth');
                        mainBody.classList.remove('sidemenuArabic');
                    }

                } else {
                    // Sidebar is visible, show back arrow and hide menu icon
                    menuBtn.classList.add('line');
                    menuBtn.classList.add('line');
                    menuBtn.classList.add('line');
                    menuBtn.classList.remove('close');

                    var language = "{{@AuthLabelsPortal.language}}";
                    if (language == "{{English}}") {
                        mainBody.classList.add('sidemenuEnglish');
                        mainBody.classList.remove('sidemenuEnglish11');
                    } else {
                        mainBody.classList.add('sidemenuArabic');
                        mainBody.classList.remove('sidemenuArabicWithFullWidth');
                    }
                }
            });
        });
    </script>

    <script>$htmlOld = "";
        function btnshowLoader(btnId) {
            $htmlOld = "";
            $htmlOld = $("#" + btnId).html();
            $("#" + btnId).prop('disabled', true);
            $("#" + btnId).html('<i class="fa fa-spinner fa-spin"" style="font-size:20px"></i>Loading...');

            $("button").prop('disabled', true);
            $("a").prop('disabled', true);
        }

        function btnhideLoader(btnId) {
            $("#" + btnId).html($htmlOld);
            $("#" + btnId).prop('disabled', false);
            $("button").prop('disabled', false);
            $("a").prop('disabled', false);
        }



        function LogoutNew(isFromAuth) {
            debugger;
            fetch('/Users/Auth/LogoutSession', {
                method: 'POST'
            })
                .then(() => {
                    if (isFromAuth == "True") {
                        window.location.replace("https://authportal.ubspropt.com/Users");
                        //window.location.replace("https://localhost:7299/Users");
                    } else {
                        window.location.replace("https://tenantportal.ubspropt.com/Users");
                        //window.location.replace("https://localhost:7276/Users");
                    }
                })
                .catch(() => {
                    if (isFromAuth == "True") {
                        window.location.replace("https://authportal.ubspropt.com/Users");
                        //window.location.replace("https://localhost:7299/Users");
                    } else {
                        window.location.replace("https://tenantportal.ubspropt.com/Users");
                        //window.location.replace("https://localhost:7276/Users");
                    }
                });

        }


        $('.seelct2Dropdown').select2();
        let lastOpenedDropdown = null;
        $(document).on('select2:open', function (e) {
            const targetId = e.target?.id;
            if (targetId) {
                const elementToFocus = document.querySelector(`[aria-controls="select2-${targetId}-results"]`);
                if (elementToFocus) {
                    elementToFocus.focus();
                } else {
                    console.warn(`Element with aria-controls="select2-${targetId}-results" not found.`);
                }
            } else {
                console.warn('Event target ID is missing.');
            }
        });
                //# DatePicker
        /*flatpickr(".datepicker", {
            enableTime: false,
            dateFormat: 'd/m/Y'
        });*/</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
