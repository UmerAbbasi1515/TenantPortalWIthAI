                                </a>
                                <span class="badge rounded-pill badge-tertiary">3</span>
                                <div class="custom-menu message-dropdown py-0">
                                    <h5 class="title bg-primary-light">@LabelsTenantPortal.message</h5>
                                    <ul>
                                        <!-- Message items here -->
